# Client
# Leave empty in Vercel when frontend and API routes share the same deployment.
# Set this only when pointing the client at a separate backend, such as local development.
VITE_API_BASE_URL=

# Server-side only. Never expose these values through VITE_* variables.
CALL_E_API_KEY=your_calle_api_key
CALL_E_BASE_URL=https://api.heycall-e.com

# Optional when frontend and API are same-origin on Vercel.
ALLOWED_ORIGIN=

# Optional development allowlist. Leave empty/unset for a public demo that accepts
# different consented recipient numbers.
CALL_E_ALLOWED_RECIPIENTS=

# Public demo safeguards.
DEMO_PUBLIC_MODE=true
DEMO_CALL_LIMIT_PER_PHONE=3
DEMO_GLOBAL_CALL_LIMIT=50
DEMO_CALL_WINDOW_SECONDS=86400

# Recommended for persistent limits on serverless deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional separate HMAC secret for hashing recipient numbers in rate-limit keys.
# If omitted, the server uses CALL_E_API_KEY as the HMAC secret.
DEMO_RATE_LIMIT_SECRET=

# Used only by the standalone local Node backend in backend/server.mjs.
PORT=8787
