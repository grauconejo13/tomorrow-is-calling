# Client
VITE_API_BASE_URL=http://localhost:8787

# Backend only. Never expose these values through VITE_* variables.
CALL_E_API_KEY=your_calle_api_key
CALL_E_BASE_URL=https://api.heycall-e.com
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787

# Optional development allowlist. Leave empty for a public demo that accepts
# different consented recipient numbers.
CALL_E_ALLOWED_RECIPIENTS=

# Public demo safeguards.
DEMO_PUBLIC_MODE=true
DEMO_CALL_LIMIT_PER_PHONE=3
DEMO_GLOBAL_CALL_LIMIT=50
DEMO_CALL_WINDOW_SECONDS=86400

# Optional but recommended for persistent limits on serverless deployments.
# Provision a Redis-compatible REST store (for example Upstash) and set either
# the UPSTASH_* pair below or the equivalent KV_REST_API_* variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional separate HMAC secret for hashing recipient numbers in rate-limit keys.
# If omitted, the backend uses CALL_E_API_KEY as the HMAC secret.
DEMO_RATE_LIMIT_SECRET=
